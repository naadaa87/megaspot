[Unit]
Description=Process Megaspot deposit notification outbox
After=network-online.target

[Service]
Type=oneshot
User=megaspot-aligo
Group=megaspot-aligo
EnvironmentFile=/etc/megaspot-aligo.env
ExecStart=/usr/bin/node /opt/megaspot-aligo/deposit-tick.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=70
