@megaspot_amano {
    path /megaspot/amano
    method POST
}
handle @megaspot_amano {
    request_body {
        max_size 16KB
    }
    rewrite * /v1/amano
    reverse_proxy 127.0.0.1:8790 {
        header_up -Cookie
        header_down -Server
        lb_retries 0
        transport http {
            dial_timeout 2s
            response_header_timeout 55s
            read_timeout 55s
            write_timeout 5s
        }
    }
}
