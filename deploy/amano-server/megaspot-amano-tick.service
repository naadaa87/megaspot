[Unit]
Description=Check paid Megaspot parking orders and register Amano discounts
After=network-online.target megaspot-amano.service
Requires=megaspot-amano.service
[Service]
Type=oneshot
User=megaspot-aligo
Group=megaspot-aligo
EnvironmentFile=/etc/megaspot-aligo.env
ExecStart=/usr/bin/node /opt/megaspot-amano/tick.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=240
