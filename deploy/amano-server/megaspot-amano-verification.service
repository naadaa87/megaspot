[Unit]
Description=Record first live order verification for Megaspot parking
After=network-online.target megaspot-amano.service
Requires=megaspot-amano.service
[Service]
Type=oneshot
User=megaspot-aligo
Group=megaspot-aligo
EnvironmentFile=/etc/megaspot-aligo.env
ExecStart=/usr/bin/node /opt/megaspot-amano/tick.mjs --report=2026-11-05
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/megaspot-amano
UMask=0077
TimeoutStartSec=240
